<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug R26;Release R26</Configurations>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>RevitCortex.Plugin</RootNamespace>
    <AssemblyName>RevitCortex.Plugin</AssemblyName>
    <Version>1.0.50</Version>
    <AssemblyVersion>1.0.50.0</AssemblyVersion>
    <FileVersion>1.0.50.0</FileVersion>
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <!-- Dev side-by-side identity. -->
  <PropertyGroup Condition="'$(DevBuild)' == 'true'">
    <AssemblyName>RevitCortex.Plugin.Dev</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nice3point.Revit.Toolkit" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.62.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <VendoredRoslynDep Include="$(MSBuildProjectDirectory)\runtime-deps\*.dll" />
  </ItemGroup>

  <Target Name="CopyVendoredRoslynDepsAfterBuild" AfterTargets="Build">
    <Copy SourceFiles="@(VendoredRoslynDep)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

  <Target Name="CopyVendoredRoslynDepsAfterPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(VendoredRoslynDep)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\RevitCortex.Core\RevitCortex.Core.csproj" />
  </ItemGroup>
</Project>
