<Page x:Class="RevitCortex.Plugin.UI.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="General" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="RevitCortex fork — Autodesk Revit 2026" Foreground="#666" Margin="0,0,0,20"/>

            <TextBlock Text="Connection" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="RevitCortex communicates locally with the MCP server. This fork is built and tested for Autodesk Revit 2026 only."
                       TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,18"/>

            <TextBlock Text="Safety" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Use dedicated tools whenever possible. Code execution remains separately controlled from the Tools settings and requires confirmation before running."
                       TextWrapping="Wrap" Foreground="#555"/>
        </StackPanel>
    </ScrollViewer>
</Page>
