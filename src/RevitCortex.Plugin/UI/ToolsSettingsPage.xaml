<Page x:Class="RevitCortex.Plugin.UI.ToolsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Tools" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="Revit 2026 tool settings" Foreground="#666" Margin="0,0,0,20"/>

            <CheckBox x:Name="EnableCodeExecutionCheckBox"
                      Content="Enable C# code execution (send_code_to_revit)"
                      Margin="0,0,0,6"/>
            <TextBlock Text="Allows last-resort C# execution through the Revit 2026 / .NET 8 Roslyn executor. Critical execution still requires confirmation; the confirmation window can optionally use a visible 10-second auto-approval countdown."
                       TextWrapping="Wrap" Foreground="#555" Margin="22,0,0,18"/>
        </StackPanel>
    </ScrollViewer>
</Page>
