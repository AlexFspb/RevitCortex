<Window x:Class="RevitCortex.Plugin.UI.CriticalConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitCortex Critical Confirmation"
        Width="450"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="White"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="CommandLink" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F6FC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7DA7D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E1EDF9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F86C6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C62828" BorderThickness="0,3,0,0" Background="White">
        <StackPanel Margin="0">
            <TextBlock x:Name="InstructionText"
                       FontSize="15"
                       Foreground="#003C8F"
                       TextWrapping="Wrap"
                       Margin="18,16,18,8"/>

            <TextBlock x:Name="DescriptionText"
                       FontSize="12"
                       Foreground="#555"
                       TextWrapping="Wrap"
                       Margin="18,0,18,10"/>

            <Border Margin="18,2,18,10"
                    Padding="10"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="2"
                    Background="#FAFAFA">
                <StackPanel>
                    <CheckBox x:Name="AutoApproveCheckBox"
                              Content="Allow auto-run"
                              FontSize="12"
                              FontWeight="SemiBold"
                              Checked="AutoApprove_Checked"
                              Unchecked="AutoApprove_Unchecked"/>
                    <TextBlock Text="When enabled, C# scripts are approved automatically after a 3-second countdown. The setting stays active for this Revit session."
                               FontSize="11"
                               Foreground="#666"
                               TextWrapping="Wrap"
                               Margin="22,4,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="YesButton"
                    Style="{StaticResource CommandLink}"
                    Margin="10,0,10,2"
                    Click="Yes_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2192;"
                               FontSize="15"
                               Foreground="#1565C0"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="YesTitleText"
                                   Text="Yes"
                                   FontSize="13"
                                   Foreground="#1565C0"/>
                        <TextBlock Text="Approve this operation"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="NoButton"
                    Style="{StaticResource CommandLink}"
                    Margin="10,0,10,12"
                    Click="No_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2192;"
                               FontSize="15"
                               Foreground="#1565C0"
                               VerticalAlignment="Top"
                               Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="No"
                                   FontSize="13"
                                   Foreground="#1565C0"/>
                        <TextBlock Text="Cancel this operation"
                                   FontSize="11"
                                   Foreground="#666"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>
