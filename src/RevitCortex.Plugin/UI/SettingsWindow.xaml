<Window x:Class="RevitCortex.Plugin.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitCortex — Revit 2026 Settings"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,18">
                <Button Content="General" Height="36" Margin="0,0,0,6" Click="General_Click"/>
                <Button Content="Tools" Height="36" Click="Tools_Click"/>
            </StackPanel>
        </Border>
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
