<Window x:Class="RevitCortex.Plugin.UI.OperationConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitCortex 2026 — Подтверждение операции"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="True" WindowStyle="SingleBorderWindow" Background="White"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="#FB8C00" BorderThickness="0,3,0,0" Padding="18">
        <StackPanel>
            <TextBlock x:Name="InstructionText" FontSize="15" Foreground="#003C8F"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <TextBlock x:Name="DescriptionText" FontSize="12" Foreground="#555" TextWrapping="Wrap"/>
            </ScrollViewer>
<Button x:Name="AllowOnceButton" Click="AllowOnce_Click" Padding="12,10"
                    HorizontalContentAlignment="Left" Background="#F0F6FC" BorderBrush="#7DA7D9">
                <TextBlock x:Name="AllowOnceText" Text="Разрешить однократно"
                           FontSize="13" Foreground="#1565C0" TextWrapping="Wrap"/>
            </Button>
            <TextBlock Text="Чтобы отменить эту операцию, закройте окно крестиком или нажмите Escape."
                       FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
